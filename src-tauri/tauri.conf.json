{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gift Snake 3D",
  "version": "0.1.0",
  "identifier": "com.giftsnake.desktop",
  "build": {
    "beforeDevCommand": "bash scripts/dev-server.sh 9010",
    "devUrl": "http://localhost:9010",
    "beforeBuildCommand": "node scripts/dist.mjs",
    "frontendDist": "../.tauri-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gift Snake 3D",
        "width": 480,
        "height": 854,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
